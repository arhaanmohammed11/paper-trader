# Supabase — the NEW paper-trader project (not the daily-planner one)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twelve Data. Server-only — NEVER prefix this with NEXT_PUBLIC_.
MARKET_DATA_API_KEY=

# 1 = use the mock provider. Keep this on while building UI, or StrictMode
# double-invokes and hot reload will burn the 800 credits/day in an afternoon.
MARKET_DATA_MOCK=1

# Allow trades outside 09:30-16:00 ET, filled at the last known price.
ALLOW_AFTER_HOURS_TRADING=true

# Shared secret between Supabase Cron and the evaluate-limit-orders function.
CRON_SECRET=

# Finnhub — news only (Twelve Data has no news endpoint).
# Free key from https://finnhub.io/register . Server-only.
NEWS_API_KEY=
